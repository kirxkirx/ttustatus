# TTU safety monitor — environment for the daemon (safety_monitor.py).
#
# Copy this to a file OUTSIDE the git checkout and fill in your real values, e.g.:
#   cp ttustatus.env.example /home/kirx/ttustatus.env
#   chmod 600 /home/kirx/ttustatus.env
# deploy/install.sh points the systemd unit at it (EnvironmentFile=-/home/<user>/ttustatus.env);
# run_safety_monitor.sh sources the same file with bash.
# Format: KEY=value lines, no `export`. Put a value that contains spaces, ( ) or ; in
# double quotes (both systemd and bash strip them); plain values need none.
#
# Only the daemon needs this. make_status_page.py does NOT use these keys.

# Weather Underground PWS API key (from your WU member settings). REQUIRED for rain polling.
# Replace the placeholder below (left as is, the daemon warns at startup).
TTU_SAFETY_WU_KEY=your-weather-underground-pws-api-key-here

# User-Agent of the NWS, IEM radar, hazard-feed and map-tile (CARTO/OpenStreetMap) requests.
# CRUCIAL: uncomment it and replace you@example.org with YOUR REAL e-mail address.
# OpenStreetMap (the backup radar basemap) BLOCKS a placeholder contact such as
# you@example.org, so with one no OpenStreetMap tile is requested and a radar map with no
# CARTO basemap (cached or keyed) has none; NWS asks for a real contact too. Unset, the
# default "ttu-safety-monitor" carries no contact at all. The daemon log warns at startup
# about either; the page and /setup warn while OpenStreetMap is, or would be, in use.
# TTU_SAFETY_NWS_UA="ttu-safety-monitor (+https://github.com/kirxkirx/ttustatus; you@example.org)"

# CARTO API key for the radar basemap (CARTO Dark Matter at night, Positron by day).
# Optional: CARTO composites already cached in ~/.cache/ttu-radar/ keep being used
# without it; a key is needed only to fetch new CARTO tiles (a new site, a cleared cache).
# Without one the daemon never asks CARTO (it would serve only an "API KEY REQUIRED"
# watermark) and such a map falls back to OpenStreetMap. Free, no account: request one
# by e-mail at https://carto.com/basemaps/apikey (free up to 5M requests/month,
# non-commercial use). A secret: never logged, never shown on the page. Keep this file
# chmod 600. Set it here, not inside a TTU_SAFETY_RADAR_TILE_URL.
# TTU_SAFETY_CARTO_KEY=

# Radar basemap source: auto (default: cached CARTO -> CARTO with the key ->
# OpenStreetMap -> plain background), carto (never OpenStreetMap), osm (never CARTO).
# TTU_SAFETY_RADAR_BASEMAP=auto

# Optional overrides (defaults shown):
# TTU_SAFETY_HTTP_PORT=11111
# TTU_SAFETY_LAT=33.7483333
# TTU_SAFETY_LON=-101.9584001
# TTU_SAFETY_POLL_INTERVAL=600
# TTU_SAFETY_RAIN_LATCH_HOURS=1.0

# Enclosure camera (page): disabled by default — at TTU the Pi+camera are covered
# against in-dome light pollution. Set to 1 to re-enable captures/stacking.
# TTU_STATUS_CAMERA=1
