# TTU Alpaca SafetyMonitor daemon.
# Template file — installed by deploy/install.sh with the repo path and user filled in.
[Unit]
Description=TTU Alpaca SafetyMonitor
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__REPO__
# optional secrets/overrides (WU API key, TTU_SAFETY_* vars); '-' = ok if absent
EnvironmentFile=-/home/__USER__/ttustatus.env
ExecStart=/usr/bin/python3 __REPO__/safety_monitor.py
Restart=always
# 15 s (not 5): a crash loop at 5 s writes STARTUP/CONFIG event lines + journald bursts
# ~700x/h to the SD card. Deliberately NO StartLimitBurst — a safety monitor must keep
# retrying forever rather than end up permanently stopped.
RestartSec=15

[Install]
WantedBy=multi-user.target
